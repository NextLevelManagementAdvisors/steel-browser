VITE_API_URL=http://0.0.0.0:3000
VITE_WS_URL=ws://0.0.0.0:3000
# URL of the operator's password vault, embedded as a same-console tab so
# WebAuthn security-key 2FA works outside the (USB-less) session browser.
# Vite inlines this at BUILD time - a runtime/container env var will NOT
# change it after the image is built; rebuild the UI to change it.
VITE_VAULT_URL=https://vault.nlma.io